## Offervia environment template (safe to commit)
## Copy to `.env.local` and fill in values.

# Supabase (public)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (server only — NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=

# Groq (server only)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile

# App
NEXT_PUBLIC_APP_NAME=Offervia
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe
# Public price ID is safe to expose, but keep the key naming consistent.
NEXT_PUBLIC_STRIPE_PRICE_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (SMTP) for contact/digests
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# Optional (defaults true)
SMTP_SECURE=true

# Contact form routing
CONTACT_TO=
CONTACT_FROM_NAME=Offervia
CONTACT_FROM_EMAIL=

# Cron jobs (optional but recommended for prod)
# Use as header: x-cron-secret, or ?secret=...
CRON_SECRET=
