# Copy this file to .env.local and fill in the values.
# Never commit .env.local. This file is the only env file that belongs in git.

# --- Required ---

# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. It bypasses row level security, so keep it secret.
SUPABASE_SERVICE_ROLE_KEY=

# Groq: https://console.groq.com/keys (the free tier works)
GROQ_API_KEY=

# --- Optional ---

# The public URL of the site. Used for share links, the sitemap, and password reset emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Model used for every tool, and a second model to try when the first one is
# rate limited. Set GROQ_FALLBACK_MODEL=none to turn the fallback off.
GROQ_MODEL=llama-3.1-8b-instant
GROQ_FALLBACK_MODEL=llama-3.3-70b-versatile

# Sentry error reporting. Leave blank to turn it off.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- Tests ---

# A real account on your Supabase project, used by the signed-in Playwright tests.
E2E_EMAIL=
E2E_PASSWORD=
# Leave blank to have Playwright start the dev server itself.
E2E_BASE_URL=
